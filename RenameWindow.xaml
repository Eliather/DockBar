<Window x:Class="DockBar.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Rename_Title}"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <StackPanel>
            <!-- Custom Draggable Glass Header -->
            <Grid Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=Rename_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="17"/>
                    <TextBlock Text="{local:Loc Key=Rename_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Card Input -->
            <Border Style="{StaticResource DialogCardStyle}"
                    Padding="12"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{local:Loc Key=Rename_NewName}"
                               Style="{StaticResource DialogLabelStyle}"
                               FontSize="11.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource DialogTextBoxStyle}"
                             FontSize="12"
                             Padding="10,6"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{local:Loc Key=Common_Cancel}"
                        Style="{StaticResource DialogButtonSecondaryStyle}"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Close_Click"/>
                <Button Content="{local:Loc Key=Common_Save}"
                        Style="{StaticResource DialogButtonPrimaryStyle}"
                        MinWidth="85"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
