<Window x:Class="DockBar.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Rename_Title}"
        Width="500"
        Height="300"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppCanvasBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{local:Loc Key=Rename_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="24"/>
                    <TextBlock Text="{local:Loc Key=Rename_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="88"
                        Height="88"
                        HorizontalAlignment="Right"
                        Background="{Binding BackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="22">
                    <Viewbox Width="40" Height="40"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Data="M5,7.5H13.5 M5,11.5H11.5"
                                  Stroke="{Binding ForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M11.75,17.5H15.5L19.5,13.5L15.75,9.75L11.75,13.75Z"
                                  Stroke="{Binding ForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M14.75,10.75L18.5,14.5"
                                  Stroke="{Binding ForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource DialogCardStyle}">
            <StackPanel>
                <TextBlock Text="{local:Loc Key=Rename_NewName}"
                           Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="NameBox"
                         Style="{StaticResource DialogTextBoxStyle}"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,18,0,0"
                Padding="18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{local:Loc Key=Common_Cancel}"
                        Style="{StaticResource DialogButtonSecondaryStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button Content="{local:Loc Key=Common_Save}"
                        Style="{StaticResource DialogButtonPrimaryStyle}"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
