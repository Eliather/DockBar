<Window x:Class="DockBar.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=About_Title}"
        Width="540"
        Height="420"
        MinWidth="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppCanvasBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{local:Loc Key=About_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="24"/>
                    <TextBlock Text="{Binding SubtitleText}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               MaxWidth="320"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="88"
                        Height="88"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{DynamicResource AppBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <Viewbox Width="38"
                             Height="38"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Border Width="16"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Rectangle Width="3"
                                       Height="12"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{DynamicResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="-4,0,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="6,5,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="6,0,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="6,0,0,5"/>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource DialogMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="{local:Loc Key=About_Version}"
                               Style="{StaticResource DialogMetricCaptionStyle}"/>
                    <TextBlock Text="{Binding VersionValue}"
                               Style="{StaticResource DialogMetricValueStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource DialogMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="{local:Loc Key=About_DeveloperCaption}"
                               Style="{StaticResource DialogMetricCaptionStyle}"/>
                    <TextBlock Text="{Binding DeveloperName}"
                               Style="{StaticResource DialogMetricValueStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource DialogCardStyle}"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding DescriptionText}"
                               Style="{StaticResource DialogSectionBodyStyle}"
                               Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding ConfigPathLabel}"
                               Style="{StaticResource DialogLabelStyle}"/>
                    <TextBlock Text="{Binding ConfigPathValue}"
                               Style="{StaticResource DialogMutedTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,16,0,0"
                Padding="18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{local:Loc Key=Common_Close}"
                        Style="{StaticResource DialogButtonPrimaryStyle}"
                        Click="Close_Click"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
