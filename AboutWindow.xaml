<Window x:Class="DockBar.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=About_Title}"
        Width="520"
        Height="390"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Glass Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=About_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="18"/>
                    <TextBlock Text="{Binding SubtitleText}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Info Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource DialogMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=About_Version}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding VersionValue}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource DialogMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=About_DeveloperCaption}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding DeveloperName}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource DialogCardStyle}"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding DescriptionText}"
                                   Style="{StaticResource DialogSectionBodyStyle}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ConfigPathLabel}"
                                   Style="{StaticResource DialogLabelStyle}"/>
                        <TextBlock Text="{Binding ConfigPathValue}"
                                   Style="{StaticResource DialogMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Bar Footer -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Margin="0,10,0,0"
                    Padding="10,8">
                <Grid>
                    <Button HorizontalAlignment="Left"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            ToolTip="{local:Loc Key=Common_DonationsTooltip}"
                            Click="Donations_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,21.35l-1.45-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78-3.4,6.86-8.55,11.54L12,21.35z"
                                  Fill="#FF5E5B"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Loc Key=Common_Donations}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{local:Loc Key=Common_Close}"
                                Style="{StaticResource DialogButtonPrimaryStyle}"
                                MinWidth="85"
                                Click="Close_Click"
                                IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
