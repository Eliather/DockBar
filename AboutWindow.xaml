<Window x:Class="DockBar.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=About_Title}"
        Width="520"
        Height="390"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Glass Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=About_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="18"/>
                    <TextBlock Text="{Binding SubtitleText}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Info Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource DialogMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=About_Version}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding VersionValue}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource DialogMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=About_DeveloperCaption}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding DeveloperName}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource DialogCardStyle}"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding DescriptionText}"
                                   Style="{StaticResource DialogSectionBodyStyle}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ConfigPathLabel}"
                                   Style="{StaticResource DialogLabelStyle}"/>
                        <TextBlock Text="{Binding ConfigPathValue}"
                                   Style="{StaticResource DialogMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Bar Footer -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Margin="0,10,0,0"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{local:Loc Key=Common_Close}"
                            Style="{StaticResource DialogButtonPrimaryStyle}"
                            MinWidth="85"
                            Click="Close_Click"
                            IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
