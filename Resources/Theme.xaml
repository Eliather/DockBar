                  <SolidColorBrush>#FF3B5277</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked">
              <Setter Property="Panel.Background" TargetName="ring">
                <Setter.Value>
                  <SolidColorBrush>#FF162742</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Setter Property="Border.BorderBrush" TargetName="ring">
                <Setter.Value>
                  <SolidColorBrush>#FF3773F5</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Setter Property="UIElement.Visibility" TargetName="dot">
                <Setter.Value>
                  <x:Static Member="Visibility.Visible" />
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled">
              <Setter Property="UIElement.Opacity">
                <Setter.Value>
                  <s:Double>0.45</s:Double>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>False</s:Boolean>
              </Trigger.Value>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
