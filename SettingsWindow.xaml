<Window x:Class="DockBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockBar.Converters"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Settings_Title}"
        Width="1180"
        Height="700"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppCanvasBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <TextBlock Text="{local:Loc Key=Settings_Title}"
                       Style="{StaticResource DialogWindowTitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="SettingsScroller"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="SettingsScroller_ScrollChanged">
                <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource DialogCardStyle}"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Key=Settings_Size}"
                                       Style="{StaticResource DialogSectionTitleStyle}"/>
                            <TextBlock Text="{local:Loc Key=Settings_SizeHint}"
                                       Style="{StaticResource DialogSectionBodyStyle}"
                                       Margin="0,6,0,14"/>

                            <TextBlock Text="{local:Loc Key=Settings_DockWidth}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="WidthSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource DialogSliderStyle}"
                                        Minimum="175"
                                        Maximum="640"
                                        Value="{Binding Config.DockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="NumericSettingChanged"/>
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding Config.DockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         LostFocus="NumericTextBox_LostFocus"
                                         DataObject.Pasting="NumericTextBox_Pasting"
                                         Tag="175|640"/>
                            </Grid>

                            <TextBlock Text="{local:Loc Key=Settings_IconSize}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="IconSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource DialogSliderStyle}"
                                        Minimum="16"
                                        Maximum="96"
                                        Value="{Binding Config.IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="NumericSettingChanged"/>
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding Config.IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         LostFocus="NumericTextBox_LostFocus"
                                         DataObject.Pasting="NumericTextBox_Pasting"
                                         Tag="16|96"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Key=Settings_AutoHide}"
                                       Style="{StaticResource DialogSectionTitleStyle}"/>
                            <TextBlock Text="{local:Loc Key=Settings_BehaviorHint}"
                                       Style="{StaticResource DialogSectionBodyStyle}"
                                       Margin="0,6,0,14"/>

                            <TextBlock Text="{local:Loc Key=Settings_HideDelay}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DelaySlider"
                                        Grid.Column="0"
                                        Style="{StaticResource DialogSliderStyle}"
                                        Minimum="0"
                                        Maximum="10"
                                        Value="{Binding Config.AutoHideDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="NumericSettingChanged"/>
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding Config.AutoHideDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         LostFocus="NumericTextBox_LostFocus"
                                         DataObject.Pasting="NumericTextBox_Pasting"
                                         Tag="0|10"/>
                            </Grid>

                            <TextBlock Text="{local:Loc Key=Settings_AnimDuration}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="AnimSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource DialogSliderStyle}"
                                        Minimum="50"
                                        Maximum="800"
                                        Value="{Binding Config.HideAnimationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="NumericSettingChanged"/>
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding Config.HideAnimationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         LostFocus="NumericTextBox_LostFocus"
                                         DataObject.Pasting="NumericTextBox_Pasting"
                                         Tag="50|800"/>
                            </Grid>

                            <CheckBox Content="{local:Loc Key=Settings_AutoStart}"
                                      Style="{StaticResource DialogCheckBoxStyle}"
                                      IsChecked="{Binding Config.AutoStartEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource DialogCardStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Settings_ColorTransparency}"
                                   Style="{StaticResource DialogSectionTitleStyle}"/>
                        <TextBlock Text="{local:Loc Key=Settings_AppearanceHint}"
                                   Style="{StaticResource DialogSectionBodyStyle}"
                                   Margin="0,6,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource AppInputBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc Key=Settings_Preview}"
                                               Style="{StaticResource DialogLabelStyle}"/>
                                    <TextBlock Text="{local:Loc Key=Settings_PreviewHint}"
                                               Style="{StaticResource DialogMutedTextStyle}"
                                               Margin="0,0,0,12"/>

                                    <Border Width="92"
                                            Height="206"
                                            CornerRadius="30"
                                            Background="{Binding PreviewBrush}"
                                            BorderBrush="#44FFFFFF"
                                            BorderThickness="1"
                                            Padding="12"
                                            HorizontalAlignment="Center">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="14"
                                                    Background="#22FFFFFF"
                                                    HorizontalAlignment="Center">
                                                <Viewbox Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center">
                                                    <Grid Width="24" Height="24">
                                                        <Border Width="6"
                                                                Height="18"
                                                                Background="{Binding TextBrush}"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="3,0,0,0"/>
                                                        <Ellipse Width="4"
                                                                 Height="4"
                                                                 Fill="{Binding TextBrush}"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,4,4,0"/>
                                                        <Ellipse Width="4"
                                                                 Height="4"
                                                                 Fill="{Binding TextBrush}"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"/>
                                                        <Ellipse Width="4"
                                                                 Height="4"
                                                                 Fill="{Binding TextBrush}"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Bottom"
                                                                 Margin="0,0,4,4"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,14,0,14">
                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="12"
                                                        Background="#20FFFFFF"
                                                        BorderBrush="#2AFFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"/>
                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="12"
                                                        Background="#16FFFFFF"
                                                        BorderBrush="#24FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,10,0,0"/>
                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="12"
                                                        Background="#16FFFFFF"
                                                        BorderBrush="#24FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2"
                                                       Text="DockBar"
                                                       Foreground="{Binding TextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       TextAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{local:Loc Key=Settings_PreviewSummary}"
                                               Style="{StaticResource DialogLabelStyle}"
                                               Margin="0,14,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{local:Loc Key=Settings_DockWidth}"
                                                   Style="{StaticResource DialogMutedTextStyle}"/>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding Config.DockWidth, StringFormat={}{0:F0}px}"
                                                   Style="{StaticResource DialogLabelStyle}"
                                                   Margin="12,0,0,0"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{local:Loc Key=Settings_IconSize}"
                                                   Style="{StaticResource DialogMutedTextStyle}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding Config.IconSize, StringFormat={}{0:F0}px}"
                                                   Style="{StaticResource DialogLabelStyle}"
                                                   Margin="12,6,0,0"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{local:Loc Key=Settings_GlassEffect}"
                                                   Style="{StaticResource DialogMutedTextStyle}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding GlassStatusText}"
                                                   Style="{StaticResource DialogLabelStyle}"
                                                   Margin="12,6,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc Key=Settings_ColorPicker}"
                                           Style="{StaticResource DialogLabelStyle}"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="SatValBorder"
                                            Grid.Column="0"
                                            Height="156"
                                            Background="{Binding HueBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Loaded="SatValBorder_Loaded"
                                            SizeChanged="SatValBorder_SizeChanged">
                                        <Grid>
                                            <Rectangle RadiusX="16" RadiusY="16">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="White" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle RadiusX="16" RadiusY="16">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#D8000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Canvas x:Name="SatValCanvas"
                                                    Background="Transparent"
                                                    MouseDown="SatValCanvas_MouseDown"
                                                    MouseMove="SatValCanvas_MouseMove">
                                                <Ellipse x:Name="SatValThumb"
                                                         Width="14"
                                                         Height="14"
                                                         Stroke="White"
                                                         StrokeThickness="2"
                                                         Fill="Transparent"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <Slider x:Name="HueSlider"
                                            Grid.Column="2"
                                            Style="{StaticResource DialogHueSliderStyle}"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="360"
                                            Height="156"
                                            Value="{Binding Hue, Mode=TwoWay}"
                                            ValueChanged="HueSlider_ValueChanged">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFF0000" Offset="0.0"/>
                                                <GradientStop Color="#FFFF00FF" Offset="0.17"/>
                                                <GradientStop Color="#FF0000FF" Offset="0.34"/>
                                                <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                                <GradientStop Color="#FF00FF00" Offset="0.67"/>
                                                <GradientStop Color="#FFFFFF00" Offset="0.84"/>
                                                <GradientStop Color="#FFFF0000" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="60"
                                            Height="60"
                                            Background="{Binding PreviewBrush}"
                                            BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{local:Loc Key=Settings_HexLabel}"
                                                   Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox x:Name="HexBox"
                                                 Style="{StaticResource DialogTextBoxStyle}"
                                                 Width="128"
                                                 Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="7"
                                                 LostFocus="HexBox_LostFocus"
                                                 KeyDown="HexBox_KeyDown"/>
                                        <TextBlock Text="{Binding HexColor}"
                                                   Style="{StaticResource DialogMutedTextStyle}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="{local:Loc Key=Settings_UseTransparency}"
                                          Style="{StaticResource DialogCheckBoxStyle}"
                                          Margin="0,14,0,14"
                                          IsChecked="{Binding Config.UseTransparency, Mode=TwoWay}"
                                          Checked="TransparencyToggled"
                                          Unchecked="TransparencyToggled"/>

                                <TextBlock Text="{local:Loc Key=Settings_TextColor}"
                                           Style="{StaticResource DialogLabelStyle}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{local:Loc Key=Settings_TextDark}"
                                               Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogMutedTextStyle}">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.UseLightText}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource DialogSwitchCheckBoxStyle}"
                                              IsChecked="{Binding Config.UseLightText, Mode=TwoWay}"
                                              Checked="TextColorChanged"
                                              Unchecked="TextColorChanged"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{local:Loc Key=Settings_TextLight}"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogMutedTextStyle}">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.UseLightText}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{local:Loc Key=Settings_ColorPalette}"
                                           Style="{StaticResource DialogLabelStyle}"/>
                                <UniformGrid Rows="2"
                                             Columns="6">
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#000000" Tag="#000000" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#111827" Tag="#111827" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#1F2937" Tag="#1F2937" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#334155" Tag="#334155" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#475569" Tag="#475569" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#94A3B8" Tag="#94A3B8" Click="Swatch_Click"/>

                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#E85D3F" Tag="#E85D3F" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#F4B844" Tag="#F4B844" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#2E9E6F" Tag="#2E9E6F" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#3773F5" Tag="#3773F5" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#9B5DE5" Tag="#9B5DE5" Click="Swatch_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>

            <Slider x:Name="SettingsScrollBar"
                    Grid.Column="1"
                    Margin="2,6,0,6"
                    Orientation="Vertical"
                    Minimum="0"
                    Style="{StaticResource DialogVerticalScrollerStyle}"
                    ValueChanged="SettingsScrollBar_ValueChanged"/>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,14,0,0"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{local:Loc Key=Common_About}"
                        Style="{StaticResource DialogButtonSecondaryStyle}"
                        Padding="14,8"
                        MinHeight="38"
                        Click="About_Click"/>

                <TextBlock Grid.Column="1"
                           Text="{local:Loc Key=Settings_FooterHint}"
                           Style="{StaticResource DialogMutedTextStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,20,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{local:Loc Key=Settings_DefaultConfig}"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            MinHeight="38"
                            Click="PresetWin8_Click"/>
                    <Button Content="{local:Loc Key=Common_Cancel}"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            MinHeight="38"
                            IsCancel="True"/>
                    <Button Content="{local:Loc Key=Common_Save}"
                            Style="{StaticResource DialogButtonPrimaryStyle}"
                            Padding="14,8"
                            MinHeight="38"
                            IsDefault="True"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
