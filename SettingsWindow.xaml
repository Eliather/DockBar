<Window x:Class="DockBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Settings_Title}"
        Width="1120"
        Height="680"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsSurfaceStyle" TargetType="Border" BasedOn="{StaticResource DialogSurfaceStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="SettingsInsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="SettingsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogWindowTitleStyle}">
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogSectionTitleStyle}">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="SettingsSectionBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogSectionBodyStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogLabelStyle}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingsMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogMutedTextStyle}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonSecondaryStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonPrimaryStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,10"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:Loc Key=Settings_Title}"
                           Style="{StaticResource SettingsTitleStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Click="Cancel_Click"/>
            </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="446"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource SettingsCardStyle}"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{local:Loc Key=Settings_Size}"
                               Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Grid.Row="1"
                               Text="{local:Loc Key=Settings_SizeHint}"
                               Style="{StaticResource SettingsSectionBodyStyle}"/>

                    <TextBlock Grid.Row="2"
                               Text="{local:Loc Key=Settings_DockWidth}"
                               Style="{StaticResource SettingsLabelStyle}"/>
                    <Grid Grid.Row="3"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="WidthSlider"
                                Grid.Column="0"
                                Style="{StaticResource DialogSliderStyle}"
                                Minimum="175"
                                Maximum="640"
                                Value="{Binding Config.DockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="NumericSettingChanged"/>
                        <TextBox Grid.Column="1"
                                 MinWidth="78"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding Config.DockWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 LostFocus="NumericTextBox_LostFocus"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 Tag="175|640"/>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Text="{local:Loc Key=Settings_IconSize}"
                               Style="{StaticResource SettingsLabelStyle}"/>
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="IconSlider"
                                Grid.Column="0"
                                Style="{StaticResource DialogSliderStyle}"
                                Minimum="16"
                                Maximum="96"
                                Value="{Binding Config.IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="NumericSettingChanged"/>
                        <TextBox Grid.Column="1"
                                 MinWidth="78"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding Config.IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 LostFocus="NumericTextBox_LostFocus"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 Tag="16|96"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource SettingsCardStyle}"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{local:Loc Key=Settings_AutoHide}"
                               Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Grid.Row="1"
                               Text="{local:Loc Key=Settings_BehaviorHint}"
                               Style="{StaticResource SettingsSectionBodyStyle}"/>

                    <TextBlock Grid.Row="2"
                               Text="{local:Loc Key=Settings_HideDelay}"
                               Style="{StaticResource SettingsLabelStyle}"/>
                    <Grid Grid.Row="3"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="DelaySlider"
                                Grid.Column="0"
                                Style="{StaticResource DialogSliderStyle}"
                                Minimum="0"
                                Maximum="10"
                                Value="{Binding Config.AutoHideDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="NumericSettingChanged"/>
                        <TextBox Grid.Column="1"
                                 MinWidth="78"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding Config.AutoHideDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 LostFocus="NumericTextBox_LostFocus"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 Tag="0|10"/>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Text="{local:Loc Key=Settings_AnimDuration}"
                               Style="{StaticResource SettingsLabelStyle}"/>
                    <Grid Grid.Row="5"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="AnimSlider"
                                Grid.Column="0"
                                Style="{StaticResource DialogSliderStyle}"
                                Minimum="50"
                                Maximum="800"
                                Value="{Binding Config.HideAnimationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="NumericSettingChanged"/>
                        <TextBox Grid.Column="1"
                                 MinWidth="78"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding Config.HideAnimationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 LostFocus="NumericTextBox_LostFocus"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 Tag="50|800"/>
                    </Grid>

                    <CheckBox Grid.Row="6"
                              Content="{local:Loc Key=Settings_AutoStart}"
                              Style="{StaticResource DialogCheckBoxStyle}"
                              VerticalAlignment="Bottom"
                              Margin="0,2,0,0"
                              IsChecked="{Binding Config.AutoStartEnabled, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="2"
                    Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{local:Loc Key=Settings_ColorTransparency}"
                               Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Grid.Row="1"
                               Text="{local:Loc Key=Settings_AppearanceHint}"
                               Style="{StaticResource SettingsSectionBodyStyle}"/>

                    <Grid Grid.Row="2"
                          Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="{local:Loc Key=Settings_Preview}"
                                           Style="{StaticResource SettingsLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Width="64"
                                        Height="110"
                                        Margin="0,0,0,8"
                                        CornerRadius="14"
                                        Background="{Binding PreviewBrush}"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        Padding="6"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="6"
                                                Background="#22FFFFFF"
                                                HorizontalAlignment="Center">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Grid Width="24" Height="24">
                                                    <Border Width="6" Height="18" Background="{Binding TextBrush}" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    <Ellipse Width="4" Height="4" Fill="{Binding TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"/>
                                                    <Ellipse Width="4" Height="4" Fill="{Binding TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Ellipse Width="4" Height="4" Fill="{Binding TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                                                </Grid>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                            <Border Width="22" Height="22" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" HorizontalAlignment="Center"/>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="DockBar" Foreground="{Binding TextBrush}" FontWeight="SemiBold" FontSize="8.5" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding HexLabelText}"
                                           Style="{StaticResource SettingsLabelStyle}"
                                           Margin="0,2,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Background="{Binding ActiveColorBrush}"
                                            BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"/>
                                    <TextBox x:Name="HexBox"
                                             Grid.Column="2"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="7"
                                             LostFocus="HexBox_LostFocus"
                                             KeyDown="HexBox_KeyDown"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             FontWeight="SemiBold"
                                             FontSize="11"/>
                                </Grid>

                                <TextBlock Text="{local:Loc Key=Settings_PreviewSummary}"
                                           Style="{StaticResource SettingsLabelStyle}"
                                           Margin="0,2,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{local:Loc Key=Settings_DockWidth}" Style="{StaticResource SettingsMutedStyle}" FontSize="10.5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Config.DockWidth, StringFormat={}{0:F0}px}" Style="{StaticResource SettingsLabelStyle}" FontSize="10.5" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Text="{local:Loc Key=Settings_IconSize}" Style="{StaticResource SettingsMutedStyle}" FontSize="10.5" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Config.IconSize, StringFormat={}{0:F0}px}" Style="{StaticResource SettingsLabelStyle}" FontSize="10.5" Margin="4,2,0,0"/>

                                    <TextBlock Grid.Row="2" Text="{local:Loc Key=Settings_GlassEffect}" Style="{StaticResource SettingsMutedStyle}" FontSize="10.5" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GlassStatusText}" Style="{StaticResource SettingsLabelStyle}" FontSize="10.5" Margin="4,2,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ColorPickerTitle}"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource DialogSurfaceStyle}"
                                            Padding="2"
                                            CornerRadius="5">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TargetBgRadio"
                                                         Content="{local:Loc Key=Settings_ColorTargetBg}"
                                                         IsChecked="{Binding IsEditingBackground, Mode=TwoWay}"
                                                         Checked="ColorTargetChanged"
                                                         Style="{StaticResource DialogSegmentedRadioStyle}"/>
                                            <RadioButton x:Name="TargetAccentRadio"
                                                         Content="{local:Loc Key=Settings_ColorTargetAccent}"
                                                         IsChecked="{Binding IsEditingAccent, Mode=TwoWay}"
                                                         Checked="ColorTargetChanged"
                                                         Margin="3,0,0,0"
                                                         Style="{StaticResource DialogSegmentedRadioStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="SatValBorder"
                                            Grid.Column="0"
                                            Height="95"
                                            Background="{Binding HueBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Loaded="SatValBorder_Loaded"
                                            SizeChanged="SatValBorder_SizeChanged">
                                        <Grid>
                                            <Rectangle RadiusX="12" RadiusY="12">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="White" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle RadiusX="12" RadiusY="12">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#D8000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Canvas x:Name="SatValCanvas"
                                                    Background="Transparent"
                                                    MouseDown="SatValCanvas_MouseDown"
                                                    MouseMove="SatValCanvas_MouseMove">
                                                <Ellipse x:Name="SatValThumb"
                                                         Width="12"
                                                         Height="12"
                                                         Stroke="White"
                                                         StrokeThickness="2"
                                                         Fill="Transparent"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <Slider x:Name="HueSlider"
                                            Grid.Column="2"
                                            Style="{StaticResource DialogHueSliderStyle}"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="360"
                                            Height="95"
                                            Value="{Binding Hue, Mode=TwoWay}"
                                            ValueChanged="HueSlider_ValueChanged">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFF0000" Offset="0.0"/>
                                                <GradientStop Color="#FFFF00FF" Offset="0.17"/>
                                                <GradientStop Color="#FF0000FF" Offset="0.34"/>
                                                <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                                <GradientStop Color="#FF00FF00" Offset="0.67"/>
                                                <GradientStop Color="#FFFFFF00" Offset="0.84"/>
                                                <GradientStop Color="#FFFF0000" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsInsetCardStyle}"
                                    Padding="14,10">
                                <StackPanel>
                                    <!-- 1. Activar efecto Glass Checkbox -->
                                    <CheckBox Content="{local:Loc Key=Settings_UseTransparency}"
                                              Style="{StaticResource DialogCheckBoxStyle}"
                                              IsChecked="{Binding Config.UseTransparency, Mode=TwoWay}"
                                              Checked="TransparencyToggled"
                                              Unchecked="TransparencyToggled"
                                              Margin="0,0,0,8"/>

                                    <!-- 2. Opacity Slider on its own full-width row below Glass checkbox -->
                                    <Grid Margin="0,0,0,10"
                                          IsEnabled="{Binding Config.UseTransparency}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{local:Loc Key=Settings_Opacity}"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource DialogSliderStyle}"
                                                Minimum="0.0"
                                                Maximum="1.0"
                                                SmallChange="0.01"
                                                LargeChange="0.05"
                                                Value="{Binding Config.BackgroundOpacity, Mode=TwoWay}"
                                                ValueChanged="OpacitySlider_ValueChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding OpacityPercentText}"
                                                   Style="{StaticResource SettingsMutedStyle}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Separator line -->
                                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,0,0,8"/>

                                    <!-- 3. Text Color Switch on its own clean row -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="{local:Loc Key=Settings_TextColor}"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{local:Loc Key=Settings_TextDark}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DialogMutedTextStyle}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.UseLightText}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <CheckBox Style="{StaticResource DialogSwitchCheckBoxStyle}"
                                                  IsChecked="{Binding Config.UseLightText, Mode=TwoWay}"
                                                  Checked="TextColorChanged"
                                                  Unchecked="TextColorChanged"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Text="{local:Loc Key=Settings_TextLight}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DialogMutedTextStyle}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.UseLightText}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 4. Text Shadow CheckBox on its own full-width row below Text Color -->
                                    <CheckBox Content="{local:Loc Key=Settings_TextShadowOption}"
                                              Style="{StaticResource DialogCheckBoxStyle}"
                                              IsChecked="{Binding Config.EnableTextShadow, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="{local:Loc Key=Settings_ColorPalette}"
                                           Style="{StaticResource SettingsLabelStyle}"/>
                                <UniformGrid Margin="0,4,0,0"
                                             Rows="2"
                                             Columns="6">
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#000000" Tag="#000000" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#111827" Tag="#111827" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#1F2937" Tag="#1F2937" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#334155" Tag="#334155" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#475569" Tag="#475569" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#94A3B8" Tag="#94A3B8" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource DialogSwatchButtonStyle}" Background="#E85D3F" Tag="#E85D3F" Click="Swatch_Click"/>
