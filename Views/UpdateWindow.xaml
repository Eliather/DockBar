<Window x:Class="DockBar.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockBar.Converters"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Update_Title}"
        Width="560"
        SizeToContent="Height"
        MinWidth="520"
        MaxHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Glass Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=Update_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="18"/>
                    <TextBlock Text="{local:Loc Key=Update_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Version Comparison Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DialogMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Update_CurrentVersion}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding CurrentVersionText}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource DialogMetricCardStyle}"
                        BorderBrush="{DynamicResource AppAccentBrush}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Update_LatestVersion}"
                                   Style="{StaticResource DialogMetricCaptionStyle}"/>
                        <TextBlock Text="{Binding LatestVersionText}"
                                   Style="{StaticResource DialogMetricValueStyle}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Release Notes Card -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogCardStyle}"
                    Margin="0,0,0,10"
                    Padding="12"
                    MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Update_ChangelogTitle}"
                                   Style="{StaticResource DialogSectionTitleStyle}"
                                   FontSize="12.5"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   Style="{StaticResource DialogSectionBodyStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Download Progress Card -->
            <Border Grid.Row="3"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Margin="0,0,0,10"
                    Padding="10"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               Margin="0,0,0,6"/>
                    <ProgressBar Height="5"
                                 Value="{Binding DownloadProgress}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Foreground="{DynamicResource AppAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Action Bar Footer -->
            <Border Grid.Row="4"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               VerticalAlignment="Center"
                               Margin="4,0,10,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{local:Loc Key=Update_RemindLater}"
                                Style="{StaticResource DialogButtonSecondaryStyle}"
                                Margin="0,0,8,0"
                                MinWidth="80"
                                IsCancel="True"
                                Click="Close_Click"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="{Binding InstallButtonText}"
                                Style="{StaticResource DialogButtonPrimaryStyle}"
                                MinWidth="85"
                                IsDefault="True"
                                IsEnabled="{Binding CanInstall}"
                                Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
