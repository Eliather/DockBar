<Window x:Class="DockBar.StoreAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockBar.Converters"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Store_Title}"
        Width="840"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Glass Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=Store_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="18"/>
                    <TextBlock Text="{local:Loc Key=Store_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Search Bar Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource DialogCardStyle}"
                    Margin="0,0,0,10"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{local:Loc Key=Store_Search}"
                               Style="{StaticResource DialogLabelStyle}"
                               FontSize="11.5"
                               Margin="0,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="SearchBox"
                             Style="{StaticResource DialogTextBoxStyle}"
                             FontSize="12"
                             Padding="9,6"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                             TextChanged="SearchBox_TextChanged"/>

                    <Button Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource DialogSmallButtonStyle}"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Loc Key=Store_Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- App List View -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogCardStyle}"
                    Padding="0">
                <Grid>
                    <!-- Loading View -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True"
                                     Width="180"
                                     Height="5"
                                     Margin="0,0,0,10"
                                     Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Text="{local:Loc Key=Store_Loading}"
                                   Style="{StaticResource DialogMutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"/>
                    </StackPanel>

                    <!-- Empty View -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{local:Loc Key=Store_Empty}"
                                   Style="{StaticResource DialogSectionTitleStyle}"
                                   HorizontalAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>

                    <!-- List View -->
                    <ListBox x:Name="AppsList"
                             ItemsSource="{Binding AppsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="AppsList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemRoot"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemRoot" Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}"/>
                                                    <Setter TargetName="itemRoot" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemRoot" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                                    <Setter TargetName="itemRoot" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding Icon}"
                                           Width="24"
                                           Height="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding PackageFamilyName}"
                                                   Style="{StaticResource DialogMutedTextStyle}"
                                                   FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Action Bar Footer -->
            <Border Grid.Row="3"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Margin="0,10,0,0"
                    Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{local:Loc Key=Store_PanelFooter}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="4,0,12,0"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{local:Loc Key=Common_Cancel}"
                                Style="{StaticResource DialogButtonSecondaryStyle}"
                                Margin="0,0,8,0"
                                MinWidth="80"
                                IsCancel="True"
                                Click="Close_Click"/>
                        <Button Content="{local:Loc Key=Common_Add}"
                                Style="{StaticResource DialogButtonPrimaryStyle}"
                                MinWidth="85"
                                IsDefault="True"
                                Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
