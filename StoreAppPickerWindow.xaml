<Window x:Class="DockBar.StoreAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockBar.Converters"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=Store_Title}"
        Width="860"
        Height="600"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppCanvasBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="2,0,2,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,22,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=Store_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="20"/>
                    <TextBlock Text="{local:Loc Key=Store_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               MaxWidth="500"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="54"
                        Height="54"
                        HorizontalAlignment="Right"
                        Background="{Binding BackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Viewbox Width="22"
                             Height="22"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Rectangle Width="7" Height="7" Fill="{Binding ForegroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle Width="7" Height="7" Fill="{Binding ForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle Width="7" Height="7" Fill="{Binding ForegroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle Width="7" Height="7" Fill="{Binding ForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" RadiusX="1.5" RadiusY="1.5"/>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource DialogCardStyle}"
                Margin="0,0,0,12"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{local:Loc Key=Store_Search}"
                           Style="{StaticResource DialogLabelStyle}"
                           FontSize="12"
                           Margin="0,0,0,4"/>

                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="SearchBox"
                         Style="{StaticResource DialogTextBoxStyle}"
                         FontSize="12.5"
                         Padding="11,7"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                         TextChanged="SearchBox_TextChanged"/>

                <Button Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource DialogSmallButtonStyle}"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Height="33"
                        ToolTip="{local:Loc Key=Store_RefreshTooltip}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"
                                  Fill="{DynamicResource AppTextBrush}"/>
                        </Viewbox>
                        <TextBlock Text="{local:Loc Key=Store_Refresh}"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{local:Loc Key=Store_SearchHint}"
                           Style="{StaticResource DialogMutedTextStyle}"
                           FontSize="11"
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource DialogCardStyle}"
                Padding="8">
            <Grid>
                <ListBox x:Name="AppsList"
                     Style="{StaticResource DialogListBoxStyle}"
                         ItemContainerStyle="{StaticResource DialogListBoxItemStyle}"
                         ItemsSource="{Binding AppsView}"
                         MouseDoubleClick="AppsList_MouseDoubleClick"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        Background="{DynamicResource AppSurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FriendlyName}"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding AppId}"
                                               Foreground="{DynamicResource AppTextMutedBrush}"
                                               FontSize="10.5"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="{DynamicResource AppInputBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{local:Loc Key=Store_Loading}"
                                   Style="{StaticResource DialogLabelStyle}"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Width="180"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     Background="{DynamicResource AppSurfaceRaisedBrush}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppInputBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{local:Loc Key=Store_Empty}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource DialogSurfaceStyle}"
                Margin="0,12,0,0"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{local:Loc Key=Store_PanelFooter}"
                           Style="{StaticResource DialogMutedTextStyle}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="4,0,18,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{local:Loc Key=Common_Cancel}"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            Margin="0,0,10,0"
                            IsCancel="True"/>
                    <Button Content="{local:Loc Key=Common_Add}"
                            Style="{StaticResource DialogButtonPrimaryStyle}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            IsDefault="True"
                            Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
