<Window x:Class="DockBar.AddLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="{local:Loc Key=AddLink_Title}"
        Width="780"
        Height="490"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Glass Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Loc Key=AddLink_Title}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="18"/>
                    <TextBlock Text="{local:Loc Key=AddLink_Subtitle}"
                               Style="{StaticResource DialogWindowSubtitleStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <!-- Main Input Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource DialogCardStyle}"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="{local:Loc Key=AddLink_Target}"
                               Style="{StaticResource DialogLabelStyle}"
                               FontSize="12"/>
                    <TextBox x:Name="TargetBox"
                             Style="{StaticResource DialogTextBoxStyle}"
                             FontSize="12"
                             Padding="10,7"
                             Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{local:Loc Key=AddLink_TargetHint}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#FFF05050"
                               FontSize="11"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{local:Loc Key=AddLink_NameOptional}"
                               Style="{StaticResource DialogLabelStyle}"
                               FontSize="12"
                               Margin="0,12,0,5"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource DialogTextBoxStyle}"
                             FontSize="12"
                             Padding="10,7"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{local:Loc Key=AddLink_NameHint}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Action Bar Footer -->
            <Border Grid.Row="2"
                    Style="{StaticResource DialogSurfaceStyle}"
                    Margin="0,12,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{local:Loc Key=AddLink_ExamplesFooter}"
                               Style="{StaticResource DialogMutedTextStyle}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="4,0,14,0"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{local:Loc Key=Common_Cancel}"
                                Style="{StaticResource DialogButtonSecondaryStyle}"
                                Margin="0,0,8,0"
                                MinWidth="80"
                                IsCancel="True"
                                Click="Close_Click"/>
                        <Button Content="{local:Loc Key=Common_Save}"
                                Style="{StaticResource DialogButtonPrimaryStyle}"
                                MinWidth="85"
                                IsDefault="True"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
