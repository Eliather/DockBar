<Window x:Class="DockBar.ThemedMessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="DockBar"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        AllowsTransparency="False"
        Foreground="{DynamicResource AppTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Icon & Title (Draggable) -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="{Binding DialogGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{Binding DialogGlyphBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DialogTitle}"
                               Style="{StaticResource DialogWindowTitleStyle}"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Body Message -->
            <Border Grid.Row="1"
                    Style="{StaticResource DialogCardStyle}"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <ScrollViewer MaxHeight="220"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding DialogMessage}"
                               Style="{StaticResource DialogSectionBodyStyle}"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontSize="12"
                               LineHeight="17"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="{local:Loc Key=Update_Later}"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            Margin="0,0,8,0"
                            MinWidth="80"
                            Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="BtnNo"
                            Content="No"
                            Style="{StaticResource DialogButtonSecondaryStyle}"
                            Margin="0,0,8,0"
                            MinWidth="80"
                            Visibility="{Binding ShowNoButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="BtnNo_Click"/>

                    <Button x:Name="BtnYes"
                            Content="Sí"
                            Style="{StaticResource DialogButtonPrimaryStyle}"
                            Margin="0,0,8,0"
                            MinWidth="80"
                            Visibility="{Binding ShowYesButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsDefault="True"
                            Click="BtnYes_Click"/>

                    <Button x:Name="BtnOk"
                            Content="Aceptar"
                            Style="{StaticResource DialogButtonPrimaryStyle}"
                            MinWidth="85"
                            Visibility="{Binding ShowOkButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsDefault="True"
                            Click="BtnOk_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
