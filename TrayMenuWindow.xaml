<Window x:Class="DockBar.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockBar"
        Title="DockBar"
        Width="212"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource AppAccentSoftBrush}"/>
                                <Setter TargetName="root" Property="BorderBrush" Value="{StaticResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrayMenuGlyphHostStyle" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrayMenuGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="6"
            Padding="6"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#B0000000"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.32"/>
        </Border.Effect>

        <StackPanel>
            <Border Padding="8,6"
                    Margin="0,0,0,4"
                    Background="{DynamicResource AppPanelBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="14" Height="14">
                        <Grid Width="24" Height="24">
                            <Border Width="16"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Rectangle Width="3"
                                       Height="12"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{DynamicResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="-4,0,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="6,5,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="6,0,0,0"/>
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="{DynamicResource AppTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="6,0,0,5"/>
                        </Grid>
                    </Viewbox>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DockBar"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VersionTag}"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="10"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="ToggleSide_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource TrayMenuGlyphHostStyle}">
                        <TextBlock Text="↔"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   Style="{StaticResource TrayMenuGlyphStyle}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{local:Loc Key=Tray_ToggleSide}"
                               Style="{StaticResource TrayMenuLabelStyle}"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="Settings_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource TrayMenuGlyphHostStyle}">
                        <TextBlock Text="&#xE713;"
                                   Style="{StaticResource TrayMenuGlyphStyle}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{local:Loc Key=Tray_Settings}"
                               Style="{StaticResource TrayMenuLabelStyle}"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="Update_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource TrayMenuGlyphHostStyle}">
                        <TextBlock Text="&#xE72C;"
                                   Style="{StaticResource TrayMenuGlyphStyle}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{local:Loc Key=Update_Menu}"
                               Style="{StaticResource TrayMenuLabelStyle}"/>
                </Grid>
            </Button>

            <Border Height="1"
                    Margin="3,3,3,6"
                    Background="{DynamicResource AppBorderBrush}"/>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="ConfigFolder_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource TrayMenuGlyphHostStyle}">
                        <TextBlock Text="&#xE8B7;"
                                   Style="{StaticResource TrayMenuGlyphStyle}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{local:Loc Key=Tray_ConfigFolder}"
                               Style="{StaticResource TrayMenuLabelStyle}"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="Exit_Click"
                    Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource TrayMenuGlyphHostStyle}">
                        <TextBlock Text="&#xE7E8;"
                                   Style="{StaticResource TrayMenuGlyphStyle}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{local:Loc Key=Tray_Exit}"
                               Style="{StaticResource TrayMenuLabelStyle}"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
